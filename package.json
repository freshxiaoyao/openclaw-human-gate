{
  "name": "openclaw-human-gate",
  "version": "0.1.0",
  "description": "Human-in-the-loop approval middleware for OpenClaw. Intercepts tool execution via before_tool_call and routes destructive calls through the built-in approval flow (TUI / Control UI / chat).",
  "type": "module",
  "license": "MIT",
  "keywords": ["openclaw", "plugin", "approval", "human-in-the-loop", "gate"],
  "files": ["dist", "openclaw.plugin.json"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "typebox": "1.1.39"
  },
  "peerDependencies": {
    "openclaw": ">=2026.7.1"
  },
  "peerDependenciesMeta": {
    "openclaw": { "optional": true }
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "typebox": "1.1.39"
  },
  "openclaw": {
    "extensions": ["./dist/index.js"],
    "compat": {
      "pluginApi": ">=2026.7.1",
      "minGatewayVersion": "2026.7.1"
    },
    "build": {
      "openclawVersion": "2026.7.1",
      "pluginSdkVersion": "2026.7.1"
    }
  }
}
